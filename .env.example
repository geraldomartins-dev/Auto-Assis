PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Dados públicos usados nos contratos e PDFs emitidos pelo sistema.
OFICINA_NOME=Auto+Assis
OFICINA_DOCUMENTO=
OFICINA_TELEFONE=
OFICINA_EMAIL=
OFICINA_ENDERECO=
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoassis_novo
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50

AUTH_SECRET=troque-por-uma-chave-aleatoria-longa
AUTH_EXPIRES_SECONDS=28800
TRUST_PROXY_HOPS=0

# O envio de recuperação de senha é opcional em desenvolvimento.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: endereço simples que receberá respostas ao e-mail transacional.
SMTP_REPLY_TO=

# Usadas somente uma vez por `npm run create-admin` em uma instalação nova.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
